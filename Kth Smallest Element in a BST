class Solution {
public:
void in(TreeNode* &root,vector<int>&inorder){
    if(root==NULL) return;
    in(root->left,inorder);
    inorder.push_back(root->val);
    in(root->right,inorder);
}
    int kthSmallest(TreeNode* root, int k) {
        vector<int>inorder;
        in(root,inorder);
        return inorder[k-1];
    }
};
