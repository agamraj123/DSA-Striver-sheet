#Approach 1
class Solution {
public:
    vector<int> largestValues(TreeNode* root) {
        vector<int> ans;
        if(!root) return ans;
        queue<TreeNode*> qe;
        qe.push(root);
        while(!qe.empty()){
            int size = qe.size();
            int maxi = INT_MIN;
            for(int i=0;i<size;i++){
                TreeNode* node = qe.front();
                qe.pop();
                maxi = max(maxi,node->val);
                if(node->left){
                    qe.push(node->left);
                }
                if(node->right){
                    qe.push(node->right);
                }
            }
            ans.push_back(maxi);
        }

        return ans;
    }
};
