class Solution {
public:
    int findMinArrowShots(vector<vector<int>>& points) {
        int n = points.size();
        int shot = 1;
        sort(points.begin(),points.end());
        int end = points[0][1];
        for(int i=1;i<points.size();i++){
            if(points[i][0]>end){
                end = points[i][1];
                shot++;
            }
            else{
                end = min(end,points[i][1]);
            }
        }
        return shot;
    }
};
