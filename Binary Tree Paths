class Solution {
public:
void path(TreeNode* root,vector<string>&ans,string temp){
    temp += to_string(root->val);
    if(root->left){
        path(root->left,ans,temp + "->");
    }
    if(root->right){
        path(root->right,ans,temp+"->");
    }
    if(!root->left && !root->right){
        ans.push_back(temp);
    }
}
    vector<string> binaryTreePaths(TreeNode* root) {
        vector<string> ans;
        if(!root) return ans;
        path(root,ans,"");
        return ans;
    }
};
