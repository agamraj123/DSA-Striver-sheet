#Approach 1
class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {
        double median;
        int cnt = nums1.size();
        for(int i=0;i<nums2.size();i++){
            nums1.push_back(nums2[i]);
            cnt++;
        }
        sort(nums1.begin(),nums1.end());
        if(cnt%2==0){
        cnt = cnt/2;
        int ans;
        ans = (nums1[cnt]+nums1[cnt-1]);
        median = (double)ans/2;
        return median;
        }
        else{
            cnt = cnt/2;
            median = (double)nums1[cnt];
            return median;
        }
    }
};
#Approach 2
class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {
        int n = nums1.size();
        int m = nums2.size();
        if(m<n){
            return findMedianSortedArrays(nums2,nums1);
        }
        int low = 0,high = n;
        while(low<=high){
            int cut1 = (low+high)/2;
            int cut2 = (n+m+1)/2 - cut1;
            int l1 = (cut1==0) ? INT_MIN : nums1[cut1-1];
            int r1 = (cut1==n) ? INT_MAX : nums1[cut1];
            int l2 = (cut2==0) ? INT_MIN : nums2[cut2-1];
            int r2 = (cut2==m) ? INT_MAX : nums2[cut2];

            if(l1<=r2 && l2<=r1){
                if((n+m)%2==0){
                    return (max(l1,l2) + min(r1,r2))/2.0;
                }
                else{
                    return max(l1,l2);
                }
            }
            else if(l1>r2){
                high = cut1-1;
            }
            else{
                low = cut1+1;
            }
        }
        return 0.0;
    }
};
