class Solution {
public:
void comb(int sum,int last,int k,vector<vector<int>>&ans,vector<int>&arr){
    if(arr.size()==k && sum==0){
        ans.push_back(arr);
        return;
    }

    if(arr.size()>k || sum<=0) return;

    for(int i=last;i<=9;i++){
        if(i<=sum){
            arr.push_back(i);
            comb(sum-i,i+1,k,ans,arr);
            arr.pop_back();
        }
        else{
            break;
        }
    }
}
    vector<vector<int>> combinationSum3(int k, int n) {
        vector<vector<int>> ans;
        vector<int> arr;
        comb(n,1,k,ans,arr);
        return ans;
    }
};
