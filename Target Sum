class Solution {
public:
int getsum(int ind,int target,vector<int>&nums,vector<vector<int>>&dp){
    if(ind==0){
        if(target==0 && nums[0]==0) return 2;
        if(target==0 || nums[0]==target) return 1;
        return 0;
    }
    if(dp[ind][target]!=-1) return dp[ind][target];
    int notpick = getsum(ind-1,target,nums,dp);
    int pick = 0;
    if(nums[ind]<=target){
        pick = getsum(ind-1,target-nums[ind],nums,dp);
    }

    return dp[ind][target] = pick+notpick;
}
    int findTargetSumWays(vector<int>& nums, int target) {
        int n = nums.size();
        int totSum = accumulate(nums.begin(),nums.end(),0);
        if((totSum-target)<0 || (totSum-target)%2!=0) return 0;

        int k = (totSum-target)/2;

        vector<vector<int>> dp(n,vector<int>(k+1,-1));

        return getsum(n-1,k,nums,dp);
    }
};
