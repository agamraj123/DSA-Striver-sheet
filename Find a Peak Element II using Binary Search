class Solution {
public:
int maxi(vector<vector<int>>&mat,int col){
    int k = -1;
    int idx = 0;
    for(int i=0;i<mat.size();i++){
        if(mat[i][col]>k){
            k = mat[i][col];
            idx = i;
        }
    }
    return idx;
}
    vector<int> findPeakGrid(vector<vector<int>>& mat) {
        vector<int> ans;
        int m = mat.size();
        int n = mat[0].size();
        int low = 0;
        int high = n-1;
        while(low<=high){
            int mid = (low+high)/2;
            int row = maxi(mat,mid);
            int left = mid-1>=0 ? mat[row][mid-1] : -1;
            int right = mid+1<n ? mat[row][mid+1]: -1;
            if(mat[row][mid]>left && mat[row][mid]>right){
                return {row,mid};
            }
            else if(mat[row][mid]<left){
                high = mid-1;
            }
            else low = mid+1;
        }
        return {-1,-1};
    }
};
