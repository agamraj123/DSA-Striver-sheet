class Solution {
public:
int solve(vector<int>&nums,int goal){
    if(goal<0) return 0;
        int left = 0;
        int right = 0;

        int sum = 0;

        int cnt = 0;
        while(right<nums.size()){
           sum += nums[right];

           while(sum>goal && left<nums.size()){
            sum -= nums[left];
            left++;
           }

           cnt += (right-left+1);
           right++;
        }
        return cnt;
}
    int numSubarraysWithSum(vector<int>& nums, int goal) {
        return solve(nums,goal)-solve(nums,goal-1);
    }
};
