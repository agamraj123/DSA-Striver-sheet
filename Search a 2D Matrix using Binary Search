class Solution {
public:

    bool searchMatrix(vector<vector<int>>& matrix, int target) {
        int row = matrix.size();
        int m = matrix[0].size();
        int size = row*m;
        int low = 0;
        int high = size-1;
        while(low<=high){
            int mid = low+(high-low)/2;
            int row = mid/m;
            int col = mid%m;
            if(target==matrix[row][col]) return true;
            else if(target>matrix[row][col]) low = mid+1;
            else high = mid-1;
        }
        return false;
    }
};
