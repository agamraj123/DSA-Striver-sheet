class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {
        vector<int> ans; // To store the maximum of each window
        int n = nums.size();
        
        // We store INDICES in the deque, not the actual values.
        // This helps us check if an element has "fallen out" of the window.
        deque<int> dq; 

        for(int i = 0; i < nums.size(); i++) {
            
            // --- STEP 1: REMOVE OUT-OF-BOUND ELEMENTS ---
            // If the index at the front of the deque is no longer within the 
            // current window (i.e., it's further than 'k' distance from 'i'), 
            // remove it from the front.
            if(!dq.empty() && dq.front() <= i - k) {
                dq.pop_front();
            }

            // --- STEP 2: MAINTAIN MONOTONIC PROPERTY ---
            // Before adding the current element nums[i], we remove all elements 
            // from the BACK of the deque that are smaller than nums[i].
            // Why? Because as long as nums[i] is in the window, those smaller 
            // elements can NEVER be the maximum again.
            while(!dq.empty() && nums[dq.back()] <= nums[i]) {
                dq.pop_back();
            }

            // --- STEP 3: ADD CURRENT ELEMENT ---
            // Add the current index to the back of the deque.
            dq.push_back(i);

            // --- STEP 4: RECORD THE RESULT ---
            // The sliding window is "full" once our index reaches at least k-1.
            // At this point, the largest element for the current window is 
            // always guaranteed to be at the front of our deque.
            if(i >= k - 1) {
                ans.push_back(nums[dq.front()]);
            }
        }
        
        return ans;
    }
};
