class Solution {
  public:
  int priority(char ch){
      if(ch=='+' || ch=='-') return 1;
      else if(ch=='*' || ch=='/') return 2;
      else if(ch=='^') return 3;
      
      return -1;
  }
    string infixToPostfix(string& s) {
        // code here
        int i = 0;
        string ans = "";
        stack<char> st;
        while(i<s.length()){
            if(s[i]>='A' && s[i]<='Z' || s[i]>='a' && s[i]<='z' 
            || s[i]>='0' && s[i]<='9'){
                ans += s[i];
            }
            else if(s[i]=='('){
                st.push(s[i]);
            }
            else if(s[i]==')'){
                while(!st.empty() && st.top()!='('){
                    ans += st.top();
                    st.pop();
                }
                st.pop();
            }
            else{
                while(!st.empty() && priority(s[i])<=priority(st.top())){
                    if (s[i] == '^' && st.top() == '^') break;
                    ans += st.top();
                    st.pop();
                }
                st.push(s[i]);
            }
            i++;
        }
        while(!st.empty()){
            ans += st.top();
            st.pop();
        }
        return ans;
    }
};
