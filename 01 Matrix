class Solution {
public:
    vector<vector<int>> updateMatrix(vector<vector<int>>& mat) {
        int n = mat.size();
        int m = mat[0].size();

        vector<vector<int>> dist(n,vector<int>(m,0));
        vector<vector<int>> vis(n,vector<int>(m,0));

        // {co-ordinates,dist}
        queue<pair<pair<int,int>,int>> qe;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(mat[i][j]==0){
                    // mark visited if it is 0
                    vis[i][j] = 1;
                    qe.push({{i,j},0});
                }
                else{
                    // if not 1 mark unvisited
                    vis[i][j] = 0;
                }
            }
        }

        int drow[] = {-1,0,+1,0};
        int dcol[] = {0,+1,0,-1};
        while(!qe.empty()){
            int row = qe.front().first.first;
            int col = qe.front().first.second;
            int steps = qe.front().second;

            qe.pop();
            dist[row][col] = steps;

            for(int i=0;i<4;i++){
                int nrow = row+drow[i];
                int ncol = col+dcol[i];

                // unvisited node
                if(nrow>=0 && nrow<n && ncol>=0 && ncol<m && vis[nrow][ncol]==0){
                    vis[nrow][ncol] = 1;
                    qe.push({{nrow,ncol},steps+1});
                }
            }
        }
        return dist;
    }
};
