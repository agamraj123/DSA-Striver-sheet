class Solution {
public:
int getcoin(int ind,vector<int> &coins,int amount,int n,vector<vector<int>> &dp){
    if(ind==0){
        if(amount%coins[0]==0){
            return amount/coins[0];
        }
        return 1e9;
    }

    if(dp[ind][amount]!=-1) return dp[ind][amount];
    int nottake = 0 + getcoin(ind-1,coins,amount,n,dp);

    int take = 1e9;
    if(coins[ind]<=amount){
        take = 1 + getcoin(ind,coins,amount-coins[ind],n,dp);
    }

    return dp[ind][amount] = min(take,nottake);
}
    int coinChange(vector<int>& coins, int amount) {
        int n = coins.size();
        vector<vector<int>> dp(n,vector<int>(amount+1,-1));

        int ans = getcoin(n-1,coins,amount,n,dp);
        if(ans >= 1e9) return -1;
        return ans;
        
    }
};
