class Solution {
    public int maxProduct(int[] nums) {
        int maxprod = nums[0];
        int minprod = nums[0];
        int res = nums[0];
        for(int right=1;right<nums.length;right++){
            int curr = nums[right];
            if(curr<0){
                int temp = minprod;
                minprod = maxprod;
                maxprod = temp;
            }
            maxprod = Math.max(curr,curr*maxprod);
            minprod = Math.min(curr,curr*minprod);

            res = Math.max(res,maxprod);
        }
        return res;
    }
}
