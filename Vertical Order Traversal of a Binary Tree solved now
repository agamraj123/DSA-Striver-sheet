class Solution {
public:
    vector<vector<int>> verticalTraversal(TreeNode* root) {
        
        map<int, map<int, multiset<int>>> nodes;
        
        queue<pair<TreeNode*, pair<int, int>>> qe;
        
        if (root) qe.push({root, {0, 0}});
        
        while (!qe.empty()) {
            auto p = qe.front();
            qe.pop();
            
            TreeNode* node = p.first;
            int col = p.second.first;
            int row = p.second.second;
            
            nodes[col][row].insert(node->val);
            
            if (node->left) {
                qe.push({node->left, {col - 1, row + 1}});
            }
            if (node->right) {
                qe.push({node->right, {col + 1, row + 1}});
            }
        }
        
        vector<vector<int>> ans;
        for (auto& [col, rowMap] : nodes) {
            vector<int> colNodes;
            for (auto& [row, values] : rowMap) {
                colNodes.insert(colNodes.end(), values.begin(), values.end());
            }
            ans.push_back(colNodes);
        }
        
        return ans;
    }
};
