class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        int n = nums.size();
        int pos = 0, neg = 1, i = 0;
        vector<int> ans(n);
        while(i<n){
            if(nums[i]<0){
                ans[neg] = nums[i];
                neg = neg+2;
            }
            else{
                ans[pos] = nums[i];
                pos = pos+2;
            }
            i++;
        }
        return ans;
    }
};
