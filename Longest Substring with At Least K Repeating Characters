class Solution {
public:
#define MAX 26
bool atleastK(vector<int>&freq,int k){
    for(int i=0;i<MAX;i++){
        if(freq[i]!=0 && freq[i]<k){
            return false;
        }
    }
    return true;
}
void setZeroes(vector<int>&freq){
    for(int i=0;i<MAX;i++){
        freq[i] = 0;
    }
}
    int longestSubstring(string s, int k) {
        int n = s.length();
        vector<int>freq(MAX);
        int maxlen = 0;
        for(int i=0;i<n;i++){
            setZeroes(freq);
            for(int j=i;j<n;j++){
                freq[s[j]-'a']++;
                if(atleastK(freq,k)){
                    maxlen = max(maxlen,j-i+1);
                }
            }
        }
        return maxlen;
    }
};
