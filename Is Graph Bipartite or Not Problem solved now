class Solution {
public:
bool dfs(int node,int col,vector<vector<int>>&graph,vector<int>&vis){
    vis[node] = col;

    for(auto neigh: graph[node]){
        if(vis[neigh]==-1){
            if(dfs(neigh,!col,graph,vis)==false) return false;
        }

        if(vis[neigh]==col){
            return false;
        }
    }
    return true;
}
    bool isBipartite(vector<vector<int>>& graph) {
        int V = graph.size();
        vector<int>vis(V,-1);
        for(int i=0;i<V;i++){
            if(vis[i]==-1){
                if(dfs(i,0,graph,vis)==false) return false;
            }
        }
        return true;
    }
};
