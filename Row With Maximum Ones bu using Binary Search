class Solution {
public:
int checkones(vector<int> &a,int m,int x){
    int low = 0;
    int high = m-1;
    int ans = m;
    while(low<=high){
        int mid = (low+high)/2;
        if(a[mid]>=x){
            ans = mid;
            high = mid-1;
        }
        else{
            low = mid+1;
        }
    }
    return ans;
}
    vector<int> rowAndMaximumOnes(vector<vector<int>>& mat) {
        int cnt_max = 0;
        int m = mat[0].size();
        int index = 0;
        for(int i=0;i<mat.size();i++){
            sort(mat[i].begin(),mat[i].end());
            int cnt1 = m-checkones(mat[i],m,1);
            if(cnt1>cnt_max){
                cnt_max = cnt1;
                index = i;
            }
        }
        return {index,cnt_max};
    }
};
