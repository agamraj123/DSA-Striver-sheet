class Solution {
public:
    int pivotIndex(vector<int>& nums) {
        int sum = 0;
        int rightsum = 0,leftsum = 0;
        for(int i: nums){
            rightsum += i;
        }
        for(int i=0;i<nums.size();i++){
            if(leftsum == rightsum-leftsum-nums[i]){
                return i;
            }
            leftsum += nums[i];
        }
        return -1;
    }
};
