#Approach 1
class Solution {
public:
    int canCompleteCircuit(vector<int>& gas, vector<int>& cost) {
        int n = gas.size();
        int tank = 0;
        int ind = 0;
        while(ind<gas.size()){
            if(gas[ind]-cost[ind]<0){
                ind++;
            }
            else{
                int i = ind;
                int store = 0;

                store = 0+gas[i];
                i++;
                while(i<=ind){
                    if(i==n){
                        i=0;
                    }
                    if(gas[i]-cost[i]>=0){
                    store = store-cost[i-1]+gas[i];
                    i++;
                    }
                    else{
                        ind++;
                        continue;
                    }
                }
                if(i==ind) return ind;
            }
        }
        return -1;
    }
};
#Approach 2
class Solution {
public:
    int canCompleteCircuit(vector<int>& gas, vector<int>& cost) {
        int total_gas = 0;
        int total_cost = 0;
        int startind = 0;
        int currenttank = 0;
        for(int i=0;i<gas.size();i++){
            total_gas += gas[i];
            total_cost += cost[i];
            currenttank = gas[i]-cost[i];
            if(currenttank<0){
                startind = i+1;
                currenttank = 0;
            }
        }
        if(total_gas<total_cost) return -1;
        return startind;
    }
};
