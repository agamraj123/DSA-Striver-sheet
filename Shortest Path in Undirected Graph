class Solution {
  public:
    vector<int> shortestPath(int V, vector<vector<int>> &edges, int src) {
        // code here
        vector<vector<int>> adj(V);
        for(auto it: edges){
            adj[it[0]].push_back(it[1]);
            adj[it[1]].push_back(it[0]);
        }
        vector<int> dist(V,INT_MAX);
        dist[src] = 0;
        // vector<int> vis(V,0);
        queue<int> qe;
        qe.push(src);
        
        while(!qe.empty()){
            int top = qe.front();
            qe.pop();
            // vis[top] = 1;
            
            for(auto neigh: adj[top]){
                
                if(dist[top]+1<dist[neigh]){
                    dist[neigh] = dist[top]+1;
                    qe.push(neigh);
                }
            }
        }
        
        vector<int> ans(V,-1);
         for(int i=0;i<V;i++){
             if(dist[i]!=INT_MAX){
                 ans[i] = dist[i];
             }
        }
        
        return ans;
    }
