class Solution {
public:
    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {
        priority_queue<pair<long long,vector<int>>> pq;
        for(auto it: points){
            long long ans = (long long)it[0]*it[0] + (long long)it[1]*it[1];
            pq.push({ans,it});
            if(pq.size()>k){
                pq.pop();
            }
        }
        vector<vector<int>> ans;
        while(pq.size()>0){
            auto it = pq.top();
            ans.push_back(it.second);
            pq.pop();
        }
        return ans;
    }
};
