class Solution {
public:
int max_elm(vector<int>&piles){
    int m = -1;
    for(int i=0;i<piles.size();i++){
        m = max(m,piles[i]);
    }
    return m;
}
    int minEatingSpeed(vector<int>& piles, int h) {
        int maxi = max_elm(piles);
        for(int i=1;i<=maxi;i++){
            double hours = 0;
            for(int j=0;j<piles.size();j++){
                hours += ceil((double)piles[j]/i);
            }
            if(hours<=h){
                return i;
            }
        }
        return -1;
    }
};

#2 Approach 
class Solution {
public:
int max_elm(vector<int>&piles){
    int m = -1;
    for(int i=0;i<piles.size();i++){
        m = max(m,piles[i]);
    }
    return m;
}
bool canEat(vector<int>&piles,int h,int k){
    double hours = 0;
    for(int i=0;i<piles.size();i++){
        hours += ceil((double)piles[i]/k);
    }
    return hours<=h;
}
    int minEatingSpeed(vector<int>& piles, int h) {
        int maxi = max_elm(piles);
        int low = 1,high = maxi,ans = -1;
        while(low<=high){
            int mid = low+(high-low)/2;
            if(canEat(piles,h,mid)){
                ans = mid;
                high = mid-1;
            }
            else{
                low = mid+1;
            }
        }
        return ans;
    }
};
