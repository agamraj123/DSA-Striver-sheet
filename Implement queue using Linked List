class Node {
  public:
    int data;
    Node* next;

    Node(int new_data) {
        data = new_data;
        next = nullptr;
    }
};

class myQueue {
    Node* front;
    Node* rear;
    int store;
  public:
    myQueue() {
        // Initialize your data members
        store = 0;
        front = rear = NULL;
    }

    bool isEmpty() {
        // check if the queue is empty
        return front==NULL;
    }

    void enqueue(int x) {
        // Adds an element x at the rear of the queue
        Node* temp = new Node(x);
        if(front==NULL){
            front = temp;
            rear = temp;
            store++;
            return;
        }
        rear->next = temp;
        rear = temp;
        store++;
    }

    void dequeue() {
        // Removes the front element of the queue
        if(front==NULL) return;
        Node* forw = front->next;
        front->next = NULL;
        front = forw;
        store--;
    }

    int getFront() {
        // Returns the front element of the queue
        // If queue is empty, return -1
        if(front==NULL) return -1;
        return front->data;
    }

    int size() {
        // Returns the current size of the queue.
        return store;
    }
};
