class Solution {
  public:
    int longestSubarray(vector<int>& arr, int k) {
        // code here
        int currsum = 0;
        int maxlen = 0;
        unordered_map<int,int> mpp;
        mpp[0] = -1;
        for(int i=0;i<arr.size();i++){
            currsum += arr[i];
            if(mpp.find(currsum-k)!=mpp.end()){
                maxlen = max(maxlen,i-mpp[currsum-k]);
            }
            if(mpp.find(currsum)==mpp.end()){
            mpp[currsum] = i;
            }
        }
        return maxlen;
        
    }
};
