class Solution {
public:
    int findMin(vector<int>& nums) {
        int st = 0;
        int ed = nums.size()-1;
        int ans = INT_MAX;
        while(st<=ed){
            int mid = st+(ed-st)/2;
            //if search space is sorted then nums[st] is always minm
            if(nums[st]<=nums[ed]){
                ans = min(ans,nums[st]);
                break;
            }
            // left sorted
            if(nums[st]<=nums[mid]){
                ans = min(ans,nums[st]);
                st = mid+1;
            }
            // right sorted
            else{
                ans = min(ans,nums[mid]);
                ed = mid-1;
            }
        }
        return ans;
    }
};
