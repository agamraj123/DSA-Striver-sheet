class Solution {
public:
TreeNode* build(vector<int>&inorder,int inst,int inend,vector<int>&postorder,int postst,int postend,map<int,int>&mpp){
    if(inst>inend || postst>postend) return NULL;
    // if (mpp.find(postorder[postend]) == mpp.end()) return NULL;
    TreeNode* root = new TreeNode(postorder[postend]);

    int leftind = mpp[root->val];
    int leftsz = leftind-inst;

    root->left = build(inorder,inst,leftind-1,postorder,postst,postst+leftsz-1,mpp);
    root->right = build(inorder,leftind+1,inend,postorder,postst+leftsz,postend-1,mpp);

    return root;
}
    TreeNode* buildTree(vector<int>& inorder, vector<int>& postorder) {
        if(inorder.size()!=postorder.size()) return NULL;
        map<int,int> mpp;
        for(int i=0;i<inorder.size();i++){
            mpp[inorder[i]] = i;
        }

        TreeNode* root = build(inorder,0,inorder.size()-1,postorder,0,
        postorder.size()-1,mpp);

        return root;
    }
};
