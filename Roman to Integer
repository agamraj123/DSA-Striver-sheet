class Solution {
public:
    int romanToInt(string s) {
        unordered_map<char,int>mpp = {{'I',1},{'V',5},{'X',10},{'L',50},{'C',100},{'D',500},{'M',1000}};
        // mpp.insert({'I',1});
        // mpp.insert({'V',5});
        // mpp.insert({'X',10});
        // mpp.insert({'L',50});
        // mpp.insert({'C',100});
        // mpp.insert({'D',500});
        // mpp.insert({'M',1000});

        int res = 0;
        for(int i=0;i<s.size()-1;i++){
            if(mpp[s[i]]>=mpp[s[i+1]]){
                res += mpp[s[i]];
            }
            else{
                res -= mpp[s[i]];
            }
        }

        res += mpp[s.back()];

        return res;

    }
};
