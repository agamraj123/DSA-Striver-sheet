class Solution {
public:
    int numSquares(int n) {
        if(n<=0) return 0;
        vector<int> cntPerfectSq(n+1,INT_MAX);
        cntPerfectSq[0] = 0;
        for(int i=1;i<=n;i++){
            for(int j=1;j*j<=i;j++){
                cntPerfectSq[i] = min(cntPerfectSq[i],cntPerfectSq[i-j*j]+1);
            }
        }
        return cntPerfectSq.back();
    }
};
