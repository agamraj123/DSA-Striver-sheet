class Solution {
public:
    int maxDepth(string s) {
        int len = 0;
        int maxlen = 0;
        for(char ch: s){
            if(ch=='('){
                len++;
            }
            else if(ch==')'){
                maxlen = max(len,maxlen);
                len--;
            }
        }
        return maxlen;
    }
};
