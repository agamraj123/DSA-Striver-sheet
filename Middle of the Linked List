/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* middleNode(ListNode* head) {
        int size = 1;
        ListNode* temp = head;
        while(temp!=NULL){
            temp = temp->next;
            size++;
        }
        temp = head;
        int val = (size/2);
        if(size%2==1){
            val += 1;
        }
        while(val>1){
            val--;
            temp = temp->next;
        }
        return temp;
    }
};
