class Solution {
  public:
    double minMaxDist(vector<int> &stations, int K) {
        // Code here
        int n = stations.size();
        if(n == 1) return 0.0;
        vector<int> howmany(n-1,0);
        priority_queue<pair<long double,int> >pq;
        for(int i=0;i<n-1;i++){
            pq.push({stations[i+1]-stations[i],i});
        }
        for(int gasSt = 1;gasSt<=K;gasSt++){
            auto it = pq.top();
            pq.pop();
            int secidx = it.second;
            howmany[secidx]++;
            long double diff = stations[secidx+1]-stations[secidx];
            long double newsec = diff/(long double)(howmany[secidx]+1.0);
            pq.push({newsec,secidx});
            
        }
        return pq.top().first;
    }
};
