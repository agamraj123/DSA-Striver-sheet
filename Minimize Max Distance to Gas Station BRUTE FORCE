class Solution {
  public:
    double minMaxDist(vector<int> &stations, int K) {
        // Code here
        int n = stations.size();
        vector<int> howmany(n-1,0);
        for(int gasstation = 1;gasstation<=K;gasstation++){
            long double maxlength = -1;
            int maxindx = -1;
            for(int i=0;i<n-1;i++){
                long double diff = stations[i+1]-stations[i];
                long double sectionlen = diff/(howmany[i]+1.0);
                
                if(sectionlen>maxlength){
                    maxlength = sectionlen;
                    maxindx = i;
                }
            }
            howmany[maxindx]++;
        }
        
        long double maxi = 0;
        for(int i=0;i<n-1;i++){
            long double diff = stations[i+1]-stations[i];
            long double sectionlen = diff/(howmany[i]+1.0);
            maxi = max(maxi,sectionlen);
        }
        
        return maxi;
        
    }
};
