class Solution {
public:
int maxmrect(vector<int>&psum){
    int n = psum.size();
    stack<int>st;
    int maxarea = 0;
    for(int i=0;i<=n;i++){
        while(!st.empty() && (i==n || psum[i]<psum[st.top()])){
            int height = psum[st.top()];
            st.pop();
            int width;
            if(st.empty()){
                width = i;
            }
            else{
                width = i-st.top()-1;
            }
            maxarea = max(maxarea,height*width);
        }
        st.push(i);
    }
    return maxarea;
}
    int maximalRectangle(vector<vector<char>>& matrix) {
        int n = matrix.size();
        int m = matrix[0].size();
        vector<vector<int>>psum(n,vector<int>(m,0));
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                
                if(matrix[i][j]=='1'){
                    if(i==0){
                    psum[i][j] = 1;
                    }
                    else{
                        psum[i][j] = psum[i-1][j]+1;
                    }
                }
                else{
                    psum[i][j] = 0;
                }
            }
        }
        int maxarea = 0;
        for(int i=0;i<n;i++){
            int area = maxmrect(psum[i]);
            maxarea = max(maxarea,area);
        }
        return maxarea;
    }
};
