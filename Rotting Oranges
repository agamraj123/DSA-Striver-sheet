class Solution {
public:
    int orangesRotting(vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();
        int vis[n][m];
        queue<pair<pair<int,int>,int>>qe;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(grid[i][j]==2){
                    vis[i][j] = 2;
                    qe.push({{i,j},0});
                }
                else{
                    vis[i][j] = 0;
                }
            }
        }
        int tm = 0;
        int dr[] = {-1,0,1,0};
        int dc[] = {0,1,0,-1};
        while(!qe.empty()){
            int r = qe.front().first.first;
            int c = qe.front().first.second;
            int t = qe.front().second;
            qe.pop();
            tm = max(tm,t);
            for(int i=0;i<4;i++){
                int drow = r+dr[i];
                int dcol = c+dc[i];
                if(drow>=0 && drow<n && dcol>=0 && dcol<m && vis[drow][dcol]!=2
                && grid[drow][dcol]==1){
                qe.push({{drow,dcol},t+1});
                vis[drow][dcol]=2;
                }
            }
        }
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(vis[i][j]!=2 && grid[i][j]==1){
                    return -1;
                }
            }
        }
        return tm;
    }
};
