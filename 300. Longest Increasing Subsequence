class Solution {
public:
    int lengthOfLIS(vector<int>& nums) {
        int n = nums.size();
        vector<int> tails;
        for(int i=0;i<nums.size();i++){
            int current = nums[i];
            int pos = tails.size();
            int low=0,high=tails.size()-1;
            while(low<=high){
                int mid = low+(high-low)/2;
                if(tails[mid]>=current){
                    pos = mid;
                    high = mid-1;
                }
                else{
                    low = mid+1;
                }
            }
            if(pos==tails.size()){
                tails.push_back(current);
            }
            else{
                tails[pos] = current;
            }
        }
        return tails.size();
    }
};
