#Approach 1
class Solution {
public:
int editdist(string word1,string word2,int i,int j,vector<vector<int>>dp){
    if(i<0) return j+1;
    if(j<0) return i+1;
    if(dp[i][j]!=-1) return dp[i][j];
    if(word1[i]==word2[j]){
        return dp[i][j] = 0+editdist(word1,word2,i-1,j-1,dp);
    }
    else{
        return dp[i][j] = 1+min(editdist(word1,word2,i-1,j-1,dp),min(editdist(word1,word2,i-1,j,dp),
        editdist(word1,word2,i,j-1,dp)));
    }
}
    int minDistance(string word1, string word2) {
        int m = word1.size();
        int n = word2.size();
        vector<vector<int>> dp(m,vector<int>(n,-1));
        return editdist(word1,word2,m-1,n-1,dp);
    }
};
#Approach 2
class Solution {
public:
    int minDistance(string word1, string word2) {
        int n = word1.size(),m = word2.size();
        if(n==0) return m;
        if(m==0) return n;
        vector<vector<int>> dp(n+1,vector<int>(m+1,0));
        // intialize first row and column
        for(int i=0;i<=n;i++){
            dp[i][0] = i;
        }
        for(int j=0;j<=m;j++){
            dp[0][j] = j;
        }
        for(int i=1;i<=n;i++){
            for(int j=1;j<=m;j++){
                if(word1[i-1]==word2[j-1]){
                    dp[i][j] = dp[i-1][j-1];    
                }
                else{
                    dp[i][j] = 1+min(dp[i-1][j-1],min(dp[i-1][j],dp[i][j-1]));
                }
            }
        }
        return dp[n][m];
    }
};
#Approach 3
class Solution {
public:
    int minDistance(string word1, string word2) {
        int n = word1.size(),m = word2.size();
        if(n==0) return m;
        if(m==0) return n;
        vector<int> prev(m+1,0),curr(m+1,0);
        // intialize the first row
        for(int i=0;i<=m;i++){
            prev[i] = i;
        }
        for(int i=1;i<=n;i++){
            curr[0] = i;// intialize the first column of the current row
            for(int j=1;j<=m;j++){
                if(word1[i-1]==word2[j-1]){
                    curr[j] = prev[j-1];
                }
                else{
                    curr[j] = 1 + min(prev[j-1],min(prev[j],curr[j-1]));
                }
            }
            prev = curr;
        }
        return curr[m];
    }
};
