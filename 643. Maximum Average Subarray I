class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        double maxans = 0;
        int left = 0,right = 0;
        int sum = 0;
        int val = k;
        while(right<nums.size()){
            while(val>0 && right<nums.size()){
                sum += nums[right++];
                val--;
            }
            maxans = (double)sum/k;
            while(right<nums.size()){
                sum -= nums[left++];
                sum += nums[right++];
                maxans = max(maxans,(double)sum/k);
            }
        }
        return maxans;
    }
};
