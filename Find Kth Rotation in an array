class Solution {
  public:
    int findKRotation(vector<int> &arr) {
        // Code Here
        int st = 0;
        int ed = arr.size()-1;
        int ans = INT_MAX;
        int index = -1;
        while(st<=ed){
            int mid = st+(ed-st)/2;
            if(arr[st]<=arr[ed]){
                if(arr[st]<ans){
                index = st;
                ans = arr[st];
                break;
                }
            }
            // left sorted
            if(arr[st]<=arr[mid]){
                if(arr[st]<ans){
                    index = st;
                    ans = arr[st];
                }
                st = mid+1;
            }
            // right sorted
            else{
                if(arr[mid]<ans){
                    index = mid;
                    ans = arr[st];
                }
                ed = mid-1;
            }
        }
        return index;
    }
};
