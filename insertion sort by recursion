class Solution {
  public:
  void solve(vector<int>&arr,int n,int i){
      if(i==n) return;
      
      // one pass for insertion sort 
      int j = i;
      while(j>0 && arr[j-1]>arr[j]){
          swap(arr[j],arr[j-1]);
          j--;
      }
      solve(arr,n,i+1);
      
      
  }
    void sortArr(vector<int> &arr) {
        // code here
        solve(arr,arr.size(),0);
    }
};
