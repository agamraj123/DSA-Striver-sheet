class Solution {
public:
    int ladderLength(string beginWord, string endWord, vector<string>& wordList) {
        queue<pair<string,int>> qe;
        qe.push({beginWord,1});

        unordered_set<string> word(wordList.begin(),wordList.end());

        word.erase(beginWord);
        while(!qe.empty()){
            string str = qe.front().first;
            int step = qe.front().second;
            qe.pop();

            if(str==endWord) return step;
            for(int j=0;j<str.length();j++){
                string orig = str;
            for(char ch='a';ch<='z';ch++){
                str[j] = ch;
                if(word.find(str) != word.end()){
                    word.erase(str);
                    qe.push({str,step+1});
                }
            }
            str = orig;
            }
        }
        return 0;
    }
};
