class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        int val = nums[0];
        int cnt = 0;
        int k = 0;
        int maxcnt = 0;
        for(int i=0;i<nums.size();i++){
            if(nums[i]==val && cnt<2){
                cnt++;
                nums[k++] = nums[i];
            }
            else if(nums[i]!=val){
                maxcnt += cnt;
                val = nums[i];
                cnt = 1;
                nums[k++] = nums[i];
            }
        }
        maxcnt += cnt;
        return maxcnt;
    }
};
