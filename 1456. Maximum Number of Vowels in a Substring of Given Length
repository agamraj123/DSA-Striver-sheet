class Solution {
public:
bool isVowel(char ch){
    if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'){
        return true;
    }
    return false;
}
    int maxVowels(string s, int k) {
        int n = s.length();
        int maxcnt = 0;
        int cnt = 0;
        int left = 0;
        int right = k-1;
        for(int i=left;i<=right;i++){
            if(isVowel(s[i])){
                cnt++;
            }
        }
        right++;
        maxcnt = cnt;
        while(right<n){
            if(isVowel(s[right])){
                cnt++;
            }
            if(isVowel(s[left])){
                cnt--;
            }
            left++;
            right++;
            maxcnt = max(maxcnt,cnt);
        }
        return maxcnt;
    }
};
