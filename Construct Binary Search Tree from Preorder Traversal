class Solution {
public:

    void insertnode(TreeNode* &root, int n) {
        
        if (root == NULL) {
            root = new TreeNode(n);
            return;
        }

        if (n < root->val) {
            insertnode(root->left, n);
        } 
        else {
            insertnode(root->right, n);
        }
    }

    TreeNode* bstFromPreorder(vector<int>& preorder) {
        TreeNode* root = NULL;
        
        for (int i = 0; i < preorder.size(); i++) {
            insertnode(root, preorder[i]);
        }
        
        return root;
    }
};
