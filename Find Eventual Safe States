class Solution {
public:
    vector<int> eventualSafeNodes(vector<vector<int>>& graph) {
        int V = graph.size();
        vector<vector<int>> revgraph(V);
        vector<int> indegree(V,0);
        for(int i=0;i<V;i++){
            for(auto it: graph[i]){
                revgraph[it].push_back(i);
                indegree[i]++;
            }
        }

        queue<int> qe;
        for(int i=0;i<V;i++){
            if(indegree[i]==0){
                qe.push(i);
            }
        }

        vector<int> safeNodes;
        while(!qe.empty()){
            int node = qe.front();
            qe.pop();

            safeNodes.push_back(node);

            for(auto neigh: revgraph[node]){
                indegree[neigh]--;
                if(indegree[neigh]==0){
                qe.push(neigh);
                }
            }
        }
        sort(safeNodes.begin(),safeNodes.end());
        return safeNodes;
    }
};
