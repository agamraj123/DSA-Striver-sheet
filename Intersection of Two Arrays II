class Solution {
public:
int binarysearch(int x,vector<int>&num){
    int l = 0;
    int h = num.size()-1;
    while(l<=h){
        int mid = l+(h-l)/2;

        if(num[mid]==x){
            return mid;
        }
        else if(num[mid]<x){
            l = mid+1;
        }
        else{
            h = mid-1;
        }
    }
    return -1;
}
    vector<int> intersect(vector<int>& nums1, vector<int>& nums2) {
        vector<int> common;
        unordered_map<int,int> freq;
        sort(nums2.begin(),nums2.end());
        for(int i: nums2){
            freq[i]++;
        }

        for(int i=0;i<nums1.size();i++){
            if(freq[nums1[i]]>0){
                common.push_back(nums1[i]);
                freq[nums1[i]]--;
            }
        }
        return common;
    }
};
