class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int maxlen = 0, left = 0, right = 0;
        
        while (right < nums.size()) {
            // If we encounter a 0, we consume a flip (k can go negative)
            if (nums[right] == 0) {
                k--;
            }
            
            // If we've used more flips than allowed, shrink from the left
            while (k < 0) {
                if (nums[left] == 0) {
                    k++; // Recover the flip as the 0 leaves the window
                }
                left++;
            }
            
            // At this point, the window is guaranteed to be valid
            maxlen = max(maxlen, right - left + 1);
            right++;
        }
        
        return maxlen;
    }
};
