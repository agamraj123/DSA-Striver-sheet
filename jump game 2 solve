class Solution {
public:
    int jump(vector<int>& nums) {
        int left = 0,right = 0,jumps = 0;
        while(left<=right && right<nums.size()-1){
            int farthest = 0;
            for(int i=left;i<=right;i++){
                farthest = max(farthest,i+nums[i]);
            }
            jumps++;
            left = right;
            right = farthest;
        }
        return jumps;
    }
};
