#include<bits/stdc++.h>
using namespace std;
class TreeNode{
    public:
    int data;
    TreeNode* left;
    TreeNode* right;

    TreeNode(int d){
        this->data = d;
        left = right = NULL;
    }
};
void InsertNode(TreeNode* &root,int data){
    TreeNode* curr = new TreeNode(data);
    if(root==NULL){
        root = curr;
        return;
    }
    queue<TreeNode*> qe;
    qe.push(root);
    while(!qe.empty()){
        TreeNode* top = qe.front();
        qe.pop();

        if(top->left){
            qe.push(top->left);
        }
        else{
            top->left = curr;
            return;
        }
        if(top->right){
            qe.push(top->right);
        }
        else{
            top->right = curr;
            return;
        }
    }
}
