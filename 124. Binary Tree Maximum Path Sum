class Solution {
public:
int maxsum(TreeNode* root,int &maxi){
    if(!root) return 0;
    int left = max(0,maxsum(root->left,maxi));
    int right = max(0,maxsum(root->right,maxi));
    maxi = max(maxi,left+right+root->val);
    return max(left,right)+root->val;
}
    int maxPathSum(TreeNode* root) {
        int maxi = INT_MIN;
        maxsum(root,maxi);
        return maxi;
    }
};
