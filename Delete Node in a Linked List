/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    void deleteNode(ListNode* node) {
        ListNode* prev = NULL;
        while(node->next != NULL){
            ListNode* forw = node->next;
            int d = forw->val;
            node->val = d;
            prev = node;
            node = node->next;
        }
        if(node->next==NULL){
            prev->next = NULL;
        }
    }
};
