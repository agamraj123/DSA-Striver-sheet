class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        int n = nums.size();
        int pos = 0;
        int neg = 0;
        vector<int> ans;
        bool plus = true;
        while(ans.size()<n){
            if(plus==true && pos<n){
                while(nums[pos]<0 && pos<n){
                    pos++;
                }
                if(pos!=n){
                    ans.push_back(nums[pos]);
                    pos++;
                }
                plus = false;
            }
            else if(plus==false && neg<n){
                while(nums[neg]>0 && neg<n){
                    neg++;
                }
                if(neg!=n){
                ans.push_back(nums[neg]);
                neg++;
                }
                plus = true;
            }
        }
        return ans;
    }
};
