class Solution {
public:
void dfs(vector<int>&vis,int i,vector<int>adj[]){
    vis[i] = 1;
    for(auto &neigh: adj[i]){
        if(!vis[neigh]){
            dfs(vis,neigh,adj);
        }
    }
}
    int findCircleNum(vector<vector<int>>& isConnected) {
        int V = isConnected.size();
        vector<int> adj[V];
        for(int i=0;i<V;i++){
            for(int j=0;j<V;j++){
                if(isConnected[i][j]==1 && i!=j){
                     adj[i].push_back(j);
                }
            }
        }
        int cnt = 0;
        vector<int> vis(V,0);
        for(int i=0;i<V;i++){
            if(!vis[i]){
                cnt++;
                dfs(vis,i,adj);
            }
        }
        return cnt;
    }
};
