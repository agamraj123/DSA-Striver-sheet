class Solution {
public:
    int characterReplacement(string s, int k) {
        int maxlen = 0;;
        int n = s.length();
        for(int i=0;i<n;i++){
            vector<int> count(26,0);
            int maxfreq = 0;
            for(int j=i;j<n;j++){
                count[s[j]-'A']++;

                maxfreq = max(maxfreq,count[s[j]-'A']);

                int replneeded = (j-i+1) - maxfreq;
                if(replneeded<=k){
                    maxlen = max(maxlen,j-i+1);
                }
            }
        }
        return maxlen;
    }
};
