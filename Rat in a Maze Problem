class Solution {
  public:
  void solve(int i,int j,vector<string>&ans,int n,
  vector<vector<int>>& maze,
  string move,vector<vector<int>>&visited){
      if(i==n-1 && j==n-1){
          ans.push_back(move);
          return;
      }
      
      //Downward
      if(i+1<n && !visited[i+1][j] && maze[i+1][j]==1){
          visited[i][j] = 1;
          solve(i+1,j,ans,n,maze,move+'D',visited);
          visited[i][j] = 0;
      }
      //Leftward
      if(j-1>=0 && !visited[i][j-1] && maze[i][j-1]==1){
          visited[i][j] = 1;
          solve(i,j-1,ans,n,maze,move+'L',visited);
          visited[i][j] = 0;
      }
      //Rightward
      if(j+1<n && !visited[i][j+1] && maze[i][j+1]==1){
          visited[i][j] = 1;
          solve(i,j+1,ans,n,maze,move+'R',visited);
          visited[i][j] = 0;
      }
      // Uppward
      if(i-1>=0 && !visited[i-1][j] && maze[i-1][j]==1){
          visited[i][j] = 1;
          solve(i-1,j,ans,n,maze,move+'U',visited);
          visited[i][j] = 0;
      }
  }
    vector<string> ratInMaze(vector<vector<int>>& maze) {
        // code here
        vector<string> ans;
        int n = maze.size();
        vector<vector<int>> visited(n,vector<int>(n,0));
        if(maze[0][0]==1){
        solve(0,0,ans,n,maze,"",visited);
        }
        return ans;
    }
};
