class Solution {
  public:
  void rootandleaf(Node* root,vector<vector<int>> &ans,vector<int>temp){
      if(root==NULL) return;
      if(root->left==NULL&&root->right==NULL){
          temp.push_back(root->data);
          ans.push_back(temp);
          return;
      }
      
      temp.push_back(root->data);
      rootandleaf(root->left,ans,temp);
      rootandleaf(root->right,ans,temp);
      temp.pop_back();
  }
    vector<vector<int>> Paths(Node* root) {
        // code here
        if(root==NULL) return {};
        vector<vector<int>> ans;
        vector<int> temp;
        rootandleaf(root,ans,temp);
        return ans;
    }
};
