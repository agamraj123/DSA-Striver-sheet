class Solution {
public:
string binarycon(int num,string res){
    if(num==0) return res;
    while(num>0){
        if(num%2==1) res += '1';
        else res += '0';

        num = num/2;
    }
    reverse(res.begin(),res.end());

    return res;
}
int convertn(int num,string res){
    int temp = 0;
    long long power = 1;
    for(int i=res.length()-1;i>=0;i--){
        if(res[i]=='1'){
            temp += (int)power;
        }
        power = power*2;
    }
    return temp;
}
    int findComplement(int num) {
        string res = "";
        res = binarycon(num,res);

        for(int i=0;i<res.length();i++){
            if(res[i]=='1'){
                res[i] = '0';
            }
            else{
                res[i] = '1';
            }
        }

        num = convertn(num,res);

        return num;
    }
};
