void InPrePost(TreeNode* root,vector<int>&pre,vector<int>&post,vector<int>&in){
    stack<pair<TreeNode*,int>> st;
    st.push({root,1});

    while(!st.empty()){
        pair<TreeNode*,int> curr = st.top();
        st.pop();

        if(curr.second==1){
            in.push_back(curr.first->data);
            curr.second++;
            st.push(curr);
            if(curr.first->left){
                st.push({curr.first->left,1});
            }
        }

        else if(curr.second==2){
            pre.push_back(curr.first->data);
            curr.second++;
            st.push(curr);
            if(curr.first->right){
                st.push({curr.first->right,1});
            }
        }

        else{
            post.push_back(curr.first->data);
        }
    }
}
int main(){
    TreeNode* root = NULL;
    InsertNode(root,1);
    InsertNode(root,3);
    InsertNode(root,5);
    InsertNode(root,9);
    InsertNode(root,11);
    InsertNode(root,13);
    InsertNode(root,15);
    InsertNode(root,17);
    InsertNode(root,19);
    InsertNode(root,21);

    vector<int> in;
    vector<int> pre;
    vector<int> post;
    InPrePost(root,in,pre,post);
    for(int i: in){
        cout<<i<<" ";
    }cout<<endl;
    for(int i: pre){
        cout<<i<<" ";
    }cout<<endl;
    for(int i: post){
        cout<<i<<" ";
    }cout<<endl;

    return 0;
}
