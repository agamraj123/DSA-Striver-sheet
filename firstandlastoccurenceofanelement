class Solution {
public:
int binaryfirst(vector<int> &nums,int k){
    int st = 0;
    int ed = nums.size()-1;
    int ans = -1;
    while(st<=ed){
        int mid = (st+ed)/2;
        if(nums[mid]==k){
            ans = mid;
            ed = mid-1;
        }
        else if(nums[mid]<k){
            st = mid+1;
        }
        else{
            ed = mid-1;
        }
    }
    return ans;
}
int binarylast(vector<int> &nums,int k){
    int st = 0;
    int ed = nums.size()-1;
    int ans = -1;
    while(st<=ed){
        int mid = (st+ed)/2;
        if(nums[mid]==k){
            ans = mid;
            st = mid+1;
        }
        else if(nums[mid]<k){
            st = mid+1;
        }
        else{
            ed = mid-1;
        }
    }
    return ans;
}
    vector<int> searchRange(vector<int>& nums, int target) {
        int first = binaryfirst(nums,target);
        int last = binarylast(nums,target);
        vector<int> ans;
        ans.push_back(first);
        ans.push_back(last);
        return ans;
    }
};
